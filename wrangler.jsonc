{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "drivu-tbl-roulette",
	"main": "src/legacy-worker.js",
	"compatibility_date": "2026-08-01",
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"CANONICAL_PUBLIC_URL": "https://drivu-tbl-summer-rewards.pages.dev/"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "drivu-tbl-roulette-prod",
			"database_id": "533b6234-72b8-4455-b0b8-8a96cc533fe7"
		}
	]
}
